# Copy to .env and fill in. .env is never committed.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
REDIS_URL=redis://localhost:6379/0

# SEC requires a real contact address on every request. The placeholder in the
# scripts is fine for a smoke test and not for a real run.
ATLAS_UA=Atlas Capstone Research <your-real-email@example.com>

# Product name lives in exactly one place. Renaming is one edit here plus one
# constant in packages/shared. It appears nowhere else in hardcoded form.
VITE_PRODUCT_NAME=Atlas
