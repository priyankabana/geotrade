# Copy to .env and fill in. .env is never committed.
# Local-dev defaults match infra/docker-compose.yml. Use your managed Postgres URL in production.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
REDIS_URL=redis://localhost:6379/0

# Docker compose overrides (optional)
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me-for-anything-but-local-dev
POSTGRES_DB=atlas

# API: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Frontend: where the browser finds the API (build-time, Vite)
VITE_API_URL=http://localhost:8000
VITE_PRODUCT_NAME=GeoTrade
ATLAS_PRODUCT_NAME=GeoTrade

# SEC requires a real contact address on every request.
ATLAS_UA=GeoTrade Capstone Research <your-real-email@example.com>
